# Supabase Configuration
SUPABASE_URL=your_supabase_project_url
SUPABASE_KEY=your_supabase_anon_key
SUPABASE_SERVICE_KEY=your_supabase_service_role_key

# JWT Configuration
SECRET_KEY=your_secret_key_here_generate_with_openssl_rand_hex_32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Admin Credentials (Initial setup)
ADMIN_EMAIL=your_email@example.com
ADMIN_PASSWORD=your_secure_password

# Environment
ENVIRONMENT=development

# Microsoft Clarity (Settings -> Data Export -> Generate new API token).
# Project-scoped, so no project id is needed for API calls. Never expose to the
# frontend: the admin reads Clarity through /api/analytics/clarity/insights.
CLARITY_API_TOKEN=
# The tag id used by the public tracking snippet (also hardcoded in
# src/utils/clarity.js and public/clarity.js).
CLARITY_PROJECT_ID=y83iybmxln
# Clarity allows 10 export calls per project per UTC day; cache this long.
CLARITY_CACHE_MINUTES=360
